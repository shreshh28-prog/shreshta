ls = []
size = int(input('enter size of array'))
for _ in range(size):
    ls.append(int(input('enter element')))
    
def insertion_sort(lst):
    for i in range(1, size):
        key = lst[i]
        j = i - 1
        while j >= 0 and key < lst[j]:
            lst[j + 1] = lst[j]
            j = j - 1
        lst[j + 1] = key
    return lst

print('sorted array is:', insertion_sort(ls))
