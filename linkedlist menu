# Linked List Menu Program in Python

class Node:
    """Class to represent a node in the linked list."""
    def __init__(self, data):
        self.data = data
        self.next = None


class LinkedList:
    """Class to represent the linked list and its operations."""
    def __init__(self):
        self.head = None

    def insert(self, data):
        """Insert a new node at the end of the list."""
        new_node = Node(data)
        if not self.head:
            self.head = new_node
            print(f"{data} inserted as head node.")
            return
        current = self.head
        while current.next:
            current = current.next
        current.next = new_node
        print(f"{data} inserted at the end.")

    def delete(self, key):
        """Delete the first occurrence of key in the list."""
        if not self.head:
            print("List is empty. Nothing to delete.")
            return
        if self.head.data == key:
            self.head = self.head.next
            print(f"{key} deleted from the list.")
            return
        current = self.head
        while current.next and current.next.data != key:
            current = current.next
        if current.next:
            current.next = current.next.next
            print(f"{key} deleted from the list.")
        else:
            print(f"{key} not found in the list.")

    def search(self, key):
        """Search for a value in the list."""
        current = self.head
        position = 0
        while current:
            if current.data == key:
                print(f"{key} found at position {position}.")
                return
            current = current.next
            position += 1
        print(f"{key} not found in the list.")

    def sort(self):
        """Sort the linked list in ascending order."""
        if not self.head or not self.head.next:
            print("List is too short to sort.")
            return
        swapped = True
        while swapped:
            swapped = False
            current = self.head
            while current.next:
                if current.data > current.next.data:
                    current.data, current.next.data = current.next.data, current.data
                    swapped = True
                current = current.next
        print("List sorted in ascending order.")

    def display(self):
        """Display the linked list."""
        if not self.head:
            print("List is empty.")
            return
        current = self.head
        print("Linked List:", end=" ")
        while current:
            print(current.data, end=" -> ")
            current = current.next
        print("None")


def main():
    ll = LinkedList()

    while True:
        print("\n--- Linked List Menu ---")
        print("1. Insert")
        print("2. Delete")
        print("3. Search")
        print("4. Sort")
        print("5. Display")
        print("6. Exit")

        choice = input("Enter your choice (1-6): ").strip()

        if choice == '1':
            try:
                value = int(input("Enter value to insert: "))
                ll.insert(value)
            except ValueError:
                print("Invalid input. Please enter an integer.")
        elif choice == '2':
            try:
                value = int(input("Enter value to delete: "))
                ll.delete(value)
            except ValueError:
                print("Invalid input. Please enter an integer.")
        elif choice == '3':
            try:
                value = int(input("Enter value to search: "))
                ll.search(value)
            except ValueError:
                print("Invalid input. Please enter an integer.")
        elif choice == '4':
            ll.sort()
        elif choice == '5':
            ll.display()
        elif choice == '6':
            print("Exiting program.")
            break
        else:
            print("Invalid choice. Please select between 1-6.")


if __name__ == "__main__":
    main()
